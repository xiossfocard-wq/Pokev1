# Copier ce fichier en .env et remplir. Ne JAMAIS committer .env (voir .gitignore).

# --- Base de données ---
# Dev local (par défaut si absent) : sqlite:///./dev.db
# Production (Neon) : récupérer la "Connection string" dans le dashboard Neon,
# format postgresql://user:password@host/dbname?sslmode=require
# -> la remplacer par postgresql+psycopg2://... (même chaîne, juste le driver précisé)
DATABASE_URL=sqlite:///./dev.db

# --- Scheduler ---
CHECK_INTERVAL_MINUTES=20

# --- eBay Browse API (https://developer.ebay.com -> My Account -> Application Keys) ---
# Compte développeur gratuit, clés "Production". La Marketplace Insights API
# n'est PAS utilisée (accès restreint, voir collectors/ebay_browse.py).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_FR
EBAY_USE_SANDBOX=false

# --- Vinted (scraping respectueux, pas de clé nécessaire) ---
VINTED_ENABLED=true
VINTED_REQUEST_DELAY_SECONDS=8
VINTED_SEARCH_TEXT=carte pokemon

# --- Cardmarket (données publiques, pas de clé nécessaire) ---
# Optionnel : URL directe du fichier "Price Guide" Pokémon en masse, à
# récupérer manuellement (voir collectors/cardmarket_prices.py > docstring).
# Laisser vide -> fonctionne quand même via le lookup carte par carte.
CARDMARKET_BULK_PRICE_GUIDE_URL=

# --- ZebraDex (optionnel, complément FR — voir collectors/zebradex_prices.py) ---
# URLs de pages "série" ZebraDex séparées par des virgules, ex :
# https://zebradex.fr/fr/tcg/pokemon/ecarlate-et-violet/ev03-5/151/4,https://zebradex.fr/fr/tcg/pokemon/...
ZEBRADEX_SERIES_URLS=

# --- Anthropic (analyse qualité par vision + OCR carte, optionnel) ---
# Clé depuis https://console.anthropic.com — laisser vide pour désactiver
# ce module (le score se basera uniquement sur l'analyse texte).
ANTHROPIC_API_KEY=
VISION_MODEL=claude-sonnet-4-6

# --- Notifications Telegram (optionnel) ---
# 1. Parler à @BotFather sur Telegram, /newbot, récupérer le token
# 2. Envoyer un message à ton bot puis visiter
#    https://api.telegram.org/bot<TOKEN>/getUpdates pour récupérer ton chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Notifications email (optionnel, ex Gmail avec mot de passe d'application) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL_TO=

# --- Seuil de notification par défaut (modifiable ensuite depuis /settings) ---
DEFAULT_DEAL_SCORE_THRESHOLD=70
