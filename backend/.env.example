# Copier ce fichier en .env et remplir. Ne JAMAIS committer .env (voir .gitignore).

# --- Base de données ---
# Dev local (par défaut si absent) : sqlite:///./dev.db
# Production (Neon) : récupérer la "Connection string" dans le dashboard Neon,
# format postgresql://user:password@host/dbname?sslmode=require
# -> la remplacer par postgresql+psycopg2://... (même chaîne, juste le driver précisé)
DATABASE_URL=sqlite:///./dev.db

# --- Scheduler ---
CHECK_INTERVAL_MINUTES=20
# Collecte en arrière-plan. Vrai par défaut : c'est elle qui fait vivre
# l'app, et en local elle remplace le cron externe dont l'hébergement
# gratuit avait besoin pour rester éveillé.
# La mettre à false sert à regarder l'interface ou travailler sur le code
# sans qu'une collecte parte toute seule derrière ; les routes
# /api/admin/* restent disponibles pour déclencher un passage à la main.
SCHEDULER_ENABLED=true

# --- eBay Browse API (https://developer.ebay.com -> My Account -> Application Keys) ---
# Compte développeur gratuit, clés "Production". La Marketplace Insights API
# n'est PAS utilisée (accès restreint, voir collectors/ebay_browse.py).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_FR
EBAY_USE_SANDBOX=false

# --- Vinted (scraping respectueux, pas de clé nécessaire) ---
VINTED_ENABLED=true
VINTED_REQUEST_DELAY_SECONDS=8
VINTED_SEARCH_TEXT=carte one piece
# Optionnel : identifiant de MARQUE Vinted, pour affiner la recherche.
# Vide = aucun filtre de marque (recherche sur le seul texte). Pour le
# relever : ouvrir une annonce One Piece sur vinted.fr, suivre le lien de
# la marque, lire le nombre dans /brand/<id>-<nom>.
VINTED_BRAND_ID=

# --- Cardmarket (données publiques, pas de clé nécessaire) ---
# Optionnel : URL directe du fichier "Price Guide" en masse, à récupérer
# manuellement (voir collectors/cardmarket_prices.py > docstring).
# Laisser vide -> fonctionne quand même via le lookup carte par carte.
CARDMARKET_BULK_PRICE_GUIDE_URL=

# --- ZebraDex (optionnel, complément FR — voir collectors/zebradex_prices.py) ---
# URLs de pages "série" ZebraDex séparées par des virgules, ex :
# https://zebradex.fr/fr/tcg/one-piece/<bloc>/<serie>/<id>,https://zebradex.fr/fr/tcg/one-piece/...
ZEBRADEX_SERIES_URLS=

# --- CardNexus (deuxième référence de prix, optionnel) ---
# Clé personnelle (cnk_live_…) : compte CardNexus, Réglages → Clés API.
# C'est un secret : uniquement ici (en local) et dans les variables
# d'environnement de Render, jamais dans le code ni dans une conversation.
CARDNEXUS_API_KEY=

# --- Anthropic (analyse qualité par vision + OCR carte, optionnel) ---
# Clé depuis https://console.anthropic.com — laisser vide pour désactiver
# ce module (le score se basera uniquement sur l'analyse texte).
ANTHROPIC_API_KEY=
VISION_MODEL=claude-sonnet-4-6

# --- Notifications Telegram (optionnel) ---
# 1. Parler à @BotFather sur Telegram, /newbot, récupérer le token
# 2. Envoyer un message à ton bot puis visiter
#    https://api.telegram.org/bot<TOKEN>/getUpdates pour récupérer ton chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Notifications email (optionnel, ex Gmail avec mot de passe d'application) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL_TO=

# --- Seuil de notification par défaut (modifiable ensuite depuis /settings) ---
DEFAULT_DEAL_SCORE_THRESHOLD=70

# --- Jeu ciblé (One Piece) ---
# Ces quatre réglages sont les seuls endroits qui nomment le jeu. Aucun
# n'a pu être vérifié depuis l'environnement de développement : la
# politique réseau y refuse les hôtes concernés. Voir le README.
TCG_NAME=One Piece
ZEBRADEX_TCG_SLUG=one-piece
CARDMARKET_GAME_PATH=OnePiece
EBAY_SEARCH_KEYWORDS=one piece carte francais

# --- Illustrations des cartes ---
# Le site officiel FRANÇAIS (fr., pas en.) : le projet suit les cartes
# françaises, et c'est la liste française qui porte leurs noms et visuels.
# L'adresse se déduit du code : OP01-120 -> <base>/OP01-120.png.
# Format non vérifié depuis l'environnement de développement (hôte
# injoignable) : confirmer avec GET /api/admin/debug-card-images?code=OP01-001.
CARD_IMAGE_BASE_URL=https://fr.onepiece-cardgame.com/images/cardlist/card
CARD_IMAGE_VERIFY=true

# --- Source de prix ---
# Une boutique française : ses prix portent sur des cartes françaises, ce
# qui est exactement ce qu'on compare aux annonces. La liste officielle ne
# publie aucun prix, d'où deux sources — la structure d'un côté, les prix
# de l'autre. Reconnaissance : GET /api/admin/debug-catalog-sources.
PRIX_SOURCE_URL=https://www.opecards.fr
